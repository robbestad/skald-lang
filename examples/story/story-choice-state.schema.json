{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robbestad/skald-lang/examples/story/story-choice-state.schema.json",
  "title": "Skald saved story choices",
  "description": "Opt-in saved decisions for groups with stable alternativeIds. Selected alternatives persist until explicitly varied; locked groups must be unlocked before rerolling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "groups"],
  "properties": {
    "formatVersion": { "const": 1 },
    "groups": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alternativeId", "locked", "rerollCount"],
        "properties": {
          "alternativeId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
          "locked": { "type": "boolean" },
          "rerollCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    }
  }
}
