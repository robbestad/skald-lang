{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robbestad/skald-lang/examples/story/story.schema.json",
  "title": "Skald story envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "oneOf": [
    { "required": ["draft"] },
    { "required": ["cast", "beats"] }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "seed": { "type": ["integer", "string"] },
    "paletteIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy": { "type": "object" },
    "narrativeBrief": { "type": "string" },
    "brief": { "type": "string" },
    "deviation": { "type": "number", "minimum": 0, "maximum": 100 },
    "expansion": { "type": "number", "minimum": 0, "maximum": 100 },
    "theme": { "type": "string" },
    "writingStyle": { "type": "string" },
    "merge": { "type": "boolean" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "reasoning": { "type": ["string", "null"] },
    "storyState": { "$ref": "./story-state.schema.json" },
    "draft": { "$ref": "./story-draft.schema.json" },
    "cast": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
          "query": { "type": "string", "minLength": 1 }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
