{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robbestad/skald-lang/examples/story/story.schema.json",
  "title": "Skald story pipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["beats"],
  "properties": {
    "seed": { "type": ["integer", "string"] },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
