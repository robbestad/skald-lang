{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robbestad/skald-lang/examples/story/story.schema.json",
  "title": "Skald story envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "oneOf": [
    { "required": ["draft"] },
    { "required": ["cast", "beats"] }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "seed": { "type": ["integer", "string"] },
    "paletteIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy": { "type": "object" },
    "narrativeBrief": { "type": "string" },
    "brief": { "type": "string" },
    "deviation": { "type": "number", "minimum": 0, "maximum": 100 },
    "expansion": { "type": "number", "minimum": 0, "maximum": 100 },
    "theme": { "type": "string" },
    "writingStyle": { "type": "string" },
    "merge": { "type": "boolean" },
    "locale": { "type": "string", "enum": ["en-US", "nb-NO", "nn-NO"] },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "reasoning": { "type": ["string", "null"] },
    "storyState": { "$ref": "./story-state.schema.json" },
    "statePatch": { "$ref": "./story-state-patch.schema.json" },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variationId": { "type": "string" },
          "beatIndex": { "type": "integer", "minimum": 0 },
          "literal": { "type": "string" },
          "pattern": { "type": "string" },
          "role": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "string",
                "enum": ["identity", "plot_fact", "motif", "voice", "micro_action", "surface_detail", "decorative"]
              }
            ]
          },
          "policy": { "type": "string", "enum": ["locked", "bounded"] },
          "origin": { "type": "string", "enum": ["human", "model", "mixed", "unknown"] },
          "syncGroup": { "type": ["string", "null"] },
          "preserves": { "type": "array", "items": { "type": "string" } },
          "reviewStatus": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "draft": { "$ref": "./story-draft.schema.json" },
    "cast": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
          "query": { "type": "string", "minLength": 1 }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
