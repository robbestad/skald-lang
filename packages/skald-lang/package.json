{
  "name": "skald-lang",
  "version": "3.0.1",
  "description": "Write a pattern, get a sentence. Seeded procedural text — WASM engine, English dictionary included.",
  "license": "ISC",
  "type": "module",
  "author": {
    "name": "Sven Anders Robbestad",
    "email": "anders@robbestad.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbestad/skald-lang.git",
    "directory": "packages/skald-lang"
  },
  "homepage": "https://github.com/robbestad/skald-lang",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/robbestad/skald-lang/issues"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "import": "./index.js"
    },
    "./engine": {
      "types": "./engine.d.ts",
      "browser": "./engine-browser.js",
      "import": "./engine.js"
    },
    "./nb-no.json": "./nb-no.json",
    "./nn-no.json": "./nn-no.json",
    "./artifact": {
      "types": "./artifact.d.ts",
      "import": "./artifact.mjs"
    }
  },
  "bin": {
    "skald-lang": "cli.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "lib.js",
    "engine.js",
    "engine-browser.js",
    "engine.d.ts",
    "cli.mjs",
    "artifact.mjs",
    "artifact.d.ts",
    "en-us.json",
    "nb-no.json",
    "nn-no.json",
    "pkg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "skald",
    "procedural-text",
    "procedural-generation",
    "text-generation",
    "wasm",
    "rant",
    "seeded",
    "dictionary",
    "cli"
  ],
  "scripts": {
    "build": "bash ../../scripts/build-npm.sh",
    "test": "node test.mjs",
    "playground": "npm run dev --prefix ../../playground"
  },
  "engines": {
    "node": ">=20"
  }
}
